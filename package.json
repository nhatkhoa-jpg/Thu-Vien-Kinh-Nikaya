    "deploy:preview": "vinext-cloudflare deploy --config dist/server/wrangler.json --name thu-vien-kinh-nikaya-preview --skip-build"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
