{
  "name": "thu-vien-kinh-nikaya",
  "version": "2.0.0-mn-stage",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "python3 scripts/generate_content_registry.py",
    "build": "next build",
    "start": "next start",
    "rag:export": "node scripts/export-rag.mjs",
    "media:export": "node scripts/export-local-media-pack.mjs",
    "media:pdf": "node scripts/render-collection-pdf.mjs",
    "dev:vinext": "vinext dev --port 3001",
